{
  "$description": "Tokens semânticos da ferramenta INDIRECT (exportados de src/design/tokens.css). Valores já resolvidos em hex. Componentes usam SÓ estes nomes.",
  "color": {
    "bg":             { "dark": "#000000", "light": "#fafafa", "primitive": { "dark": "neutral-1000", "light": "neutral-50" } },
    "surface":        { "dark": "#0d0d0d", "light": "#ffffff", "primitive": { "dark": "neutral-900", "light": "neutral-0" } },
    "surface-raised": { "dark": "#161616", "light": "#f0f0f0", "primitive": { "dark": "neutral-850", "light": "neutral-100" } },
    "border":         { "dark": "#222222", "light": "#dcdcdc", "primitive": { "dark": "neutral-800", "light": "neutral-200" } },
    "border-strong":  { "dark": "#3a3a3a", "light": "#bdbdbd", "primitive": { "dark": "neutral-700", "light": "neutral-300" } },
    "text":           { "dark": "#fafafa", "light": "#000000", "primitive": { "dark": "neutral-50", "light": "neutral-1000" } },
    "text-muted":     { "dark": "#9a9a9a", "light": "#5c5c5c", "primitive": { "dark": "neutral-400", "light": "neutral-600" } },
    "primary":        { "dark": "#ff5a00", "light": "#e04e00", "primitive": { "dark": "orange-500", "light": "orange-600" } },
    "primary-hover":  { "dark": "#ff7a33", "light": "#b83f00", "primitive": { "dark": "orange-400", "light": "orange-700" } },
    "on-primary":     { "dark": "#000000", "light": "#ffffff", "primitive": { "dark": "neutral-1000", "light": "neutral-0" } },
    "focus":          { "dark": "#ff5a00", "light": "#e04e00", "primitive": { "dark": "orange-500", "light": "orange-600" } },
    "selection":      { "dark": "#ff5a00", "light": "#ff5a00", "primitive": { "dark": "orange-500", "light": "orange-500" } },
    "danger":         { "dark": "#ff3b30", "light": "#ff3b30", "primitive": { "dark": "red-500", "light": "red-500" } },
    "success":        { "dark": "#22c55e", "light": "#22c55e", "primitive": { "dark": "green-500", "light": "green-500" } }
  },
  "gameUi": {
    "$description": "Cores de conteúdo da UI do jogo (não seguem o tema da ferramenta).",
    "focusAccent": "#ff5a00",
    "wireframeDefault": "#ffffff"
  },
  "font": {
    "sans": { "family": "Space Grotesk", "fallback": "system-ui, sans-serif", "source": "@fontsource/space-grotesk (Google Fonts, OFL)", "weights": [300, 400, 500, 700] },
    "mono": { "family": "JetBrains Mono", "fallback": "ui-monospace, monospace", "source": "@fontsource/jetbrains-mono (OFL)", "weights": [400], "use": "números, medidas, código" }
  },
  "fontSize": { "xs": 11, "sm": 12, "base": 13, "md": 15, "lg": 18, "xl": 24, "2xl": 40 },
  "fontWeight": { "light": 300, "regular": 400, "medium": 500, "bold": 700 },
  "letterSpacing": { "tight": "-0.01em", "wide": "0.06em" },
  "radius": { "sm": 2, "md": 4 },
  "rules": [
    "Escuro é o padrão; claro redefine só os semânticos.",
    "Laranja só para destaque: seleção, foco, botão principal, toggles ativos.",
    "Nenhum hex direto em componente: sempre o token semântico."
  ]
}
